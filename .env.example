# Variables del analista de extractos.
#
# ESTAS DOS VAN SOLO EN NETLIFY (Site configuration → Environment variables),
# NUNCA en un archivo .env que se suba, y NUNCA con prefijo VITE_.
# Vite incrusta toda variable VITE_* dentro del bundle público, así que una llave
# con ese prefijo queda visible para cualquiera que abra las devtools.

# Tu llave de la API de Anthropic. La usa solo netlify/functions/analizar-extracto.
ANTHROPIC_API_KEY=sk-ant-...

# Secreto compartido que protege los endpoints del analista. Sin esto, cualquiera
# que encuentre la URL puede mandar PDFs y facturarlos a tu cuenta de Anthropic.
# Genera uno largo y aleatorio así:
#     openssl rand -hex 32
# Luego pégalo en Netlify y, la primera vez que abras /finanzas → Analista,
# pégalo también ahí (queda guardado en ese dispositivo).
ANALISTA_TOKEN=
