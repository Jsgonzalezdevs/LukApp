# ---------------------------------------------------------------------------
# Supabase (sincronización de Finanzas entre dispositivos).
#
# Estas DOS SÍ llevan prefijo VITE_; la clave "anon" está DISEÑADA para ser pública. Solo identifica
# el proyecto, no tiene permisos propios, y cada tabla que alcanza está protegida
# por Row Level Security dentro de PostgreSQL — la base de datos es la que impide
# que una cuenta lea la de otra, no el navegador.
#
# Lo que NUNCA debe aparecer aquí es la clave "service_role": esa se salta RLS por
# completo y solo va en un entorno de servidor.
#
# Se sacan de: Supabase → Project Settings → API
#
# Si las dejas vacías la app sigue funcionando: se queda en modo local, guardando
# en IndexedDB en el dispositivo y sin pedir login.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Variables privadas del servidor para cupos, suscripciones y facturación.
# Van en Render para `server.ts` y también en Vercel para `api/transcribir.ts`.
# JAMÁS llevan el prefijo VITE_ y JAMÁS se ponen en el navegador: la llave de
# servicio ignora RLS y solo la deben tener procesos de servidor confiables.
# Usa la URL normal de tu proyecto de Supabase, sin barra final.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Wompi Web Checkout (solo servidor / Render).
#
# Consíguelas en Wompi → Desarrolladores → Secretos para integración técnica.
# Cada ambiente tiene su propio juego: nunca mezcles las que empiezan por
# `test_`/`pub_test_` con las que empiezan por `prod_`/`pub_prod_`.
#
# En sandbox no se mueve dinero real. Cuando hayas probado todo, cambia SOLO
# WOMPI_AMBIENTE a `produccion` y reemplaza las tres llaves por las de `prod`.
# Ninguna variable de esta sección lleva VITE_: integridad y eventos son
# secretos, y la llave pública se entrega al checkout desde el servidor.
#
# WOMPI_REDIRECT_URL es una pantalla informativa de tu propio sitio. Debe usar
# HTTPS y volver a la confirmación de pago; Premium se activa exclusivamente
# mediante el webhook, nunca por esta redirección.
WOMPI_AMBIENTE=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=https://tu-dominio.com/pago/confirmado


# ---------------------------------------------------------------------------
# Origen de la API de Express (server.ts).
#
# DÉJALA VACÍA en local y en cualquier despliegue donde el sitio y la API vivan
# en el mismo host: las rutas quedan relativas y funcionan solas (en local Vite
# proxea /api al puerto 3000).
#
# Solo hace falta cuando el front y la API están en HOSTS DISTINTOS, que es el
# caso actual: el sitio en Vercel y la API en Render. Sin esto, /api pega contra
# Vercel —donde no hay nada que lo sirva— y devuelve 404.
#
# Ponla en las variables de entorno de Vercel con el origen de Render, sin barra
# final. Ejemplo:
#     VITE_API_URL=https://tu-servicio.onrender.com
VITE_API_URL=

# Orígenes del sitio autorizados a llamar a la API de Render desde un navegador.
# En producción se permiten por defecto https://lukapp.app y https://www.lukapp.app.
# Si usas un preview o dominio propio, decláralo aquí separado por comas; no
# incluyas rutas, comodines ni hosts HTTP remotos.
# CORS_ORIGINS=https://lukapp.app,https://www.lukapp.app

# SOLO desarrollo local: permite probar el API de IA sin Supabase. Va apagado
# por defecto y Render lo ignora para que una configuración incompleta nunca
# convierta la API publicada en un proxy abierto de las llaves de IA.
PERMITIR_API_SIN_SESION_EN_LOCAL=false


# ---------------------------------------------------------------------------
# Emails de administrador (frontend access control).
#
# Lista de emails que tienen acceso a /superadmin y /estadisticas.
# Separados por comas, sin espacios.
# IMPORTANTE: Esto es solo para UX — la autorización real está en la BD con RLS.
# El servidor SIEMPRE valida contra perfiles.rol, nunca contra este string.
#
# Ejemplo: admin1@example.com,admin2@example.com
VITE_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Asesor con IA (endpoint /api/asesor-ia en server.ts).
#
# NINGUNA de estas lleva prefijo VITE_, y no es un detalle menor: son llaves con
# cuota y con cobro. Una llave VITE_* queda incrustada en el bundle público, así
# que cualquiera podría sacarla de las devtools y gastársela. Van donde CORRE LA
# API — hoy Render, no Vercel.
#
# Basta con UNA. server.ts las prueba en este orden y usa la primera que
# encuentre: Groq → OpenAI → Gemini → Anthropic → DeepSeek.
#
# Si no pones ninguna, la app NO se rompe: el endpoint responde `offline: true` y
# el asesor sigue funcionando con sus reglas locales, sin IA.
#
# Gratis y recomendadas:
#   GROQ    console.groq.com     — Llama 3.3 70B, muy rápido, sin costo.
#   GEMINI  aistudio.google.com  — Gemini 1.5 Flash, sin costo.
GROQ_API_KEY=
GEMINI_API_KEY=

# Opcionales, estas sí son de pago:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
