{
  "expo": {
    "name": "LukApp",
    "slug": "julian-gonzalez",
    "owner": "lukapp",
    "scheme": "lukapp",
    "version": "10.10.33",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets-app-icon-square.png",
    "android": {
      "package": "lukApp.App",
      "versionCode": 1010033,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets-app-icon-square.png",
        "backgroundColor": "#171220"
      },
      "predictiveBackGestureEnabled": true
    },
    "extra": {
      "eas": {
        "projectId": "4e5d8a1a-2812-4fe9-a404-6854ffa3a522"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ]
  }
}
